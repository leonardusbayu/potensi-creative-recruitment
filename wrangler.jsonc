{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendarjet-hr",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker/index.ts",
  "observability": {
    "enabled": true
  },
  "vars": {
    "POSTIZ_URL": "http://localhost:3001",
    "APP_URL": "http://localhost:3000"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calendarjet_hr",
      "database_id": "local-dev-placeholder"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CV_BUCKET",
      "bucket_name": "cv-store"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CV_QUEUE",
        "queue": "cv-queue"
      }
    ],
    "consumers": [
      {
        "queue": "cv-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "cv-queue-dlq"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  }
}
