{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendarjet-hr",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker/index.ts",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_URL": "https://potensi-hr.pages.dev",
    "MEDIA_URL": "https://potensi-hr.pages.dev",
    "EMAIL_FROM": "Potensi Creative <hr@potensi-creative.id>",
    "LLM_MODEL": "deepseek/deepseek-chat"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calendarjet_hr",
      "database_id": "968fbbb0-5545-496f-b572-c6f98cf8a395"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CV_BUCKET",
      "bucket_name": "potensi-cv-store"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CV_QUEUE",
        "queue": "cv-queue"
      }
    ],
    "consumers": [
      {
        "queue": "cv-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "cv-queue-dlq"
      }
    ]
  }
}
